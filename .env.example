# Salin menjadi .env lalu isi. .env TIDAK di-commit (lihat .gitignore).
NODE_ENV=local
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_divisi
JWT_SECRET=ganti-jwt-secret-min-32-karakter-di-env-lokal
SEED_DEFAULT_PASSWORD=ganti-password-demo-lokal

# Untuk test: DATABASE_URL bisa pakai DB terpisah, misal:
# DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_divisi_test
