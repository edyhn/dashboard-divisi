generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FND-05: Foundation — 7 divisi (Wrapping, Cellular, Refleksi, Minimarket, FnB, Finance, Money Changer)
// ORG-01 akan memperluas Outlet & konfigurasi; FND-05 menyediakan migrasi awal + seed idempotent
model Division {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]

  @@map("divisions")
}

model Outlet {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  code       String   @unique
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([divisionId])
  @@map("outlets")
}
