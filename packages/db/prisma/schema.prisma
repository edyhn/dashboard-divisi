generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FND-05: Foundation — 7 divisi (Wrapping, Cellular, Refleksi, Minimarket, FnB, Finance, Money Changer)
// ORG-01 akan memperluas Outlet & konfigurasi; FND-05 menyediakan migrasi awal + seed idempotent
// FND-06: Auth baseline — User untuk 17 akun (3 BOD lintas + 7 Manager + 7 Admin strict 1:1)
model Division {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets Outlet[]
  assignments EmployeeAssignment[]
  userScopes  UserScope[]

  @@map("divisions")
}

model Outlet {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  code       String   @unique
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignments EmployeeAssignment[]
  userScopes  UserScope[]

  @@index([divisionId])
  @@map("outlets")
}

enum Role {
  BOD
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  divisionCode String? // null untuk BOD lintas 7 divisi; wajib untuk MANAGER/ADMIN strict 1:1
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  scopes       UserScope[]

  @@index([role])
  @@index([divisionCode])
  @@map("users")
}

// ORG-03: UserScope — 17 akun 7 divisi strict 1:1 (BOD null = all)
model UserScope {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  outletId   String?
  outlet     Outlet?  @relation(fields: [outletId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, divisionId])
  @@index([divisionId])
  @@map("user_scopes")
}

// ORG-02: Employee & Assignment historis — effectiveFrom/effectiveTo tidak overlap
model Employee {
  id        String   @id @default(cuid())
  code      String   @unique // NIK anonim
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EmployeeAssignment[]

  @@map("employees")
}

model EmployeeAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  divisionId    String
  division      Division  @relation(fields: [divisionId], references: [id])
  outletId      String?
  outlet        Outlet?   @relation(fields: [outletId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = current assignment
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
  @@index([divisionId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("employee_assignments")
}

// FND-08: Audit append-only — actor/entity/event/time/scope tanpa payload sensitif
model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?
  actorRole    String?
  action       String // e.g., auth.login, auth.logout, policy.scope_violation
  entity       String // e.g., User, Division, Auth
  entityId     String?
  divisionCode String?
  traceId      String?
  metadata     Json? // sanitized, never password/token
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([divisionCode])
  @@index([createdAt])
  @@map("audit_events")
}
