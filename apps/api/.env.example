# Salin file ini menjadi .env lalu sesuaikan. File .env TIDAK di-commit.
NODE_ENV=local
PORT=3000

# Wajib sejak FND-05 (Prisma/PostgreSQL) — tervalidasi di env-validation.ts
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_divisi
# Wajib sejak FND-06 (Auth) — minimal 32 karakter untuk JWT
JWT_SECRET=ganti-jwt-secret-min-32-karakter-di-env-lokal
